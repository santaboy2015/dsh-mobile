# Build output — regenerate with build.ps1 or build.sh. Releases attach the APK
# as a release asset rather than tracking it in the tree.
/DSH-Mobile.apk
*.idsig
/out/

# Generated by the build from network_security_config.template.xml. The default
# rendering is checked in so the tree is complete without running a build; if
# you build with -CleartextHosts, this keeps your local edit out of the diff.
/android/res/xml/network_security_config.xml.orig

# Real signing keys must never be committed. debug.keystore is deliberately
# tracked (see the "Releases are debug-signed" section of the README).
*.jks
*.p12
release.keystore
my-release.keystore

# Editor / OS noise
.vscode/
.idea/
*.iml
Thumbs.db
desktop.ini
.DS_Store
